[Unit]
Description=MakeMyStay Next.js (standalone)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/react-app
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /var/www/react-app/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

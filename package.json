{
  "name": "make-my-stay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "dev:vite": "vite",
    "check:local": "node scripts/check-local.mjs",
    "build": "node scripts/optimize-hero-images.mjs && next build && node scripts/prepare-next-deploy.mjs && node scripts/verify-deploy-assets.mjs --dist && node scripts/generate-version.js && node scripts/generate-sitemap.mjs",
    "analyze": "ANALYZE=true next build",
    "build:vite": "vite build && node scripts/generate-version.js && node scripts/generate-sitemap.mjs",
    "validate:sitemap": "node scripts/validate-sitemap-urls.mjs --sample 100",
    "optimize:hero": "node scripts/optimize-hero-images.mjs",
    "preview": "next start",
    "generate:next-pages": "node scripts/generate-next-pages.mjs",
    "install:next-ec2": "bash scripts/install-next-remote.sh",
    "deploy": "bash deploy.sh",
    "nginx:cleanup-ec2": "bash scripts/nginx-cleanup-remote.sh",
    "nginx:next-ec2": "bash scripts/nginx-next-remote.sh",
    "clean:vite": "rm -rf node_modules/.vite",
    "clean:code": "knip && unimported && ts-prune",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "axios": "^1.13.4",
    "framer-motion": "^12.29.2",
    "lucide-react": "^0.563.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^2.0.5",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.6",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.17.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.24",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "knip": "^5.86.0",
    "lint-staged": "^16.3.3",
    "next": "^15.5.7",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "ts-prune": "^0.10.3",
    "typescript": "^5.7.2",
    "unimported": "^1.31.0",
    "vite": "^7.3.1"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
